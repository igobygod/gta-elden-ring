<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <Reference Include="SoulsFormats"><HintPath>$(SoulsFormatsDll)</HintPath></Reference>
    <Compile Include="$(ArchiveKeysSource)" Link="ArchiveKeys.cs" />
    <!-- A DLL reference does not carry SoulsFormats' NuGet dependencies into publish. -->
    <PackageReference Include="ZstdSharp.Port" Version="[0.8.1]" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="[8.0.0]" />
  </ItemGroup>
  <Target Name="RequireDependencies" BeforeTargets="ResolveReferences" Condition="!Exists('$(SoulsFormatsDll)') Or !Exists('$(ArchiveKeysSource)')"><Error Text="Set SoulsFormatsDll and ArchiveKeysSource to locally obtained dependencies." /></Target>
</Project>
