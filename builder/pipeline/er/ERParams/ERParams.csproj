<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
<ItemGroup>
  <Reference Include="SoulsFormats"><HintPath>$(SoulsFormatsDll)</HintPath></Reference>
  <!-- A DLL reference does not carry SoulsFormats' NuGet dependencies into publish. -->
  <PackageReference Include="ZstdSharp.Port" Version="[0.8.1]" />
  <PackageReference Include="System.Text.Encoding.CodePages" Version="[8.0.0]" />
</ItemGroup>
<Target Name="RequireDependency" BeforeTargets="ResolveReferences" Condition="!Exists('$(SoulsFormatsDll)')"><Error Text="Set -p:SoulsFormatsDll to your locally built SoulsFormats DLL." /></Target>
</Project>
